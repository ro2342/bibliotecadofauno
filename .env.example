# Copy this file to .env (gitignored, never commit it) and fill in real values.
# docker compose reads .env automatically from the same directory as docker-compose.yml.

# Port the Web UI listens on (both host and container side).
# Use 8083 to drop in as a replacement for an existing calibre-web-automated instance.
CWA_PORT=8342

# Optional: Hardcover.app metadata provider. https://docs.hardcover.app/api/getting-started/
HARDCOVER_TOKEN=

# Optional: read-only Audiobookshelf integration. Leave both blank to disable.
# URL is whatever you use to reach ABS in your browser (include the port).
AUDIOBOOKSHELF_URL=
AUDIOBOOKSHELF_TOKEN=
