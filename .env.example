# Copy this file to .env (gitignored, never commit it) and fill in real values.
# docker compose reads .env automatically from the same directory as docker-compose.yml.

# Port the Web UI listens on (both host and container side).
# Use 8083 to drop in as a replacement for an existing calibre-web-automated instance.
CWA_PORT=8342

# Your timezone, e.g. Europe/Berlin. https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# Real host paths for your config/ingest/library folders. If you're migrating an existing
# calibre-web-automated install, point CWA_CONFIG_DIR at its current config folder directly.
CWA_CONFIG_DIR=/path/to/config/folder
CWA_INGEST_DIR=/path/to/ingest/folder
CWA_LIBRARY_DIR=/path/to/calibre/library

# Optional: Hardcover.app metadata provider. https://docs.hardcover.app/api/getting-started/
HARDCOVER_TOKEN=

# Optional: read-only Audiobookshelf integration. Leave both blank to disable.
# URL is whatever you use to reach ABS in your browser (include the port).
AUDIOBOOKSHELF_URL=
AUDIOBOOKSHELF_TOKEN=

# Optional: read-only sync from the original standalone Bookshelf app's Firestore
# database (for people who still use it day-to-day). Leave all blank to disable.
# - Create a service account in Google Cloud Console for the Firebase project, with
#   ONLY the "Cloud Datastore Viewer" role (read-only), and download its JSON key.
# - FIREBASE_LEGACY_KEY_HOST_PATH: real path to that key file on this host. Also
#   uncomment the matching volume line in docker-compose.yml.
# - FIREBASE_LEGACY_SERVICE_ACCOUNT_PATH: where that file appears INSIDE the
#   container - leave as-is unless you changed the volume line's target.
FIREBASE_LEGACY_PROJECT_ID=
FIREBASE_LEGACY_USER_ID=
FIREBASE_LEGACY_KEY_HOST_PATH=
FIREBASE_LEGACY_SERVICE_ACCOUNT_PATH=/config/firebase-legacy-key.json

# Optional: lets the standalone ro2342/bookshelf (static site) pull this CWA instance's
# data via GET /bookshelf/api/export. Leave BOOKSHELF_EXPORT_TOKEN blank to disable.
# Generate the token yourself, e.g.: openssl rand -hex 32
BOOKSHELF_EXPORT_TOKEN=
BOOKSHELF_EXPORT_USERNAME=
BOOKSHELF_EXPORT_ALLOWED_ORIGIN=
